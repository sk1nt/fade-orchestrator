{
  "name": "fade-orchestrator",
  "version": "0.1.0",
  "description": "Two-lane OMP coding-agent orchestrator for a local basalt router: phase contract, pre-swap gate, swap history, Alt+F overlay.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bash build.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:build && node --test \"test/*.test.mjs\"",
    "test:build": "node test/build.mjs",
    "test:gate": "node test/gate_rig.mjs",
    "test:lane": "node test/build.mjs && node test/single_lane.mjs",
    "test:rpc": "node test/build.mjs && node test/rpc_rig.mjs",
    "test:pty": "node test/build.mjs && node test/pty_rig.mjs",
    "demo": "node demo/recording.mjs",
    "demo:stop": "node demo/recording.mjs --stop",
    "demo:record": "bash -c 'mkdir -p demo/out && \"${VHS:-vhs}\" demo/linkedin.tape'"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.24",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sk1nt/fade-orchestrator.git"
  }
}
